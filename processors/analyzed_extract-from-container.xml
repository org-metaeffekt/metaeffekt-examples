<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.metaeffekt.examples.processor</groupId>
        <artifactId>processor-parent</artifactId>
        <version>EXAMPLES-SNAPSHOT</version>
        <relativePath>processor-parent.xml</relativePath>
    </parent>

    <artifactId>extract-inventory-from-container</artifactId>
    <packaging>pom</packaging>

    <properties>
        <output.inventory>/home/jonas/IdeaProjects/metaeffekt-github-examples/examples/containers/nginx-1.26/01-analyzed/nginx-1.26-analyzed.xlsx</output.inventory>
        <intermediates.dir>temp</intermediates.dir>
        <image.id>nginx:1.26</image.id>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-container-scripts</id>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <outputDirectory>${intermediates.dir}</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.metaeffekt.core</groupId>
                                    <artifactId>ae-system-analysis-scripts</artifactId>
                                    <version>${ae.core.version}</version>
                                </artifactItem>
                            </artifactItems>
                            <includes>**/container-extractors/*.sh</includes>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>1.8</version>
                <executions>
                    <execution>
                        <id>container-extractors-chmod</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <chmod perm="+x">
                                    <fileSet dir="${intermediates.dir}/ae-system-analysis-scripts-assembled/container-extractors" includes="**/*.sh"/>
                                </chmod>
                                <mkdir dir="${intermediates.dir}/analysis"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>1.4.0</version>
                <executions>
                    <execution>
                        <id>run-inventory-extractor</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <executable>docker</executable>
                            <arguments>
                                <argument>run</argument>
                                <argument>--rm</argument>
                                <argument>-i</argument>
                                <argument>-v</argument>
                                <argument>${project.basedir}/${intermediates.dir}/ae-system-analysis-scripts-assembled/container-extractors/:/container-extractors:Z</argument>
                                <argument>-v</argument>
                                <argument>${project.basedir}/${intermediates.dir}/analysis/:/analysis:Z</argument>
                                <argument>--entrypoint</argument>
                                <argument>/container-extractors/extract.sh</argument>
                                <argument>${image.id}</argument>
                            </arguments>
                            <outputFile>${intermediates.dir}/analysis/docker.extract.out.txt</outputFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-file-extractor</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <executable>docker</executable>
                            <arguments>
                                <argument>run</argument>
                                <argument>--rm</argument>
                                <argument>-i</argument>
                                <argument>-v</argument>
                                <argument>${project.basedir}/${intermediates.dir}/ae-system-analysis-scripts-assembled/container-extractors/:/container-extractors:Z</argument>
                                <argument>-v</argument>
                                <argument>${project.basedir}/${intermediates.dir}/analysis/:/analysis:Z</argument>
                                <argument>--entrypoint</argument>
                                <argument>/container-extractors/extract-filtered-files.sh</argument>
                                <argument>${image.id}</argument>
                            </arguments>
                            <outputFile>${intermediates.dir}/analysis/docker.extract-files.out.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.metaeffekt.core</groupId>
                <artifactId>ae-inventory-maven-plugin</artifactId>
                <version>${ae.core.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>extract-container-inventory</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <analysisDir>${intermediates.dir}/analysis</analysisDir>
                            <targetInventoryFile>${output.inventory}</targetInventoryFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
